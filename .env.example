# Ejemplo de configuración de HIDRO360. La demo básica NO requiere nada de esto.
# Copie a .env (está en .gitignore) solo si lo necesita. config.py lee .env al iniciar; las variables ya definidas
# en el entorno tienen prioridad. NUNCA suba .env ni pegue claves en el código, el README o los tests.
# En la Raspberry este contenido vive en /etc/hidro360/hidro360.env (lo crea deploy/raspberry/install.sh).

# --- Almacenamiento (rutas; por defecto, dentro del repositorio) ---------------------------
# Base SQLite. Defecto: agua_clara.db en la raíz.
# HIDRO360_DB=agua_clara.db
# Trazas técnicas JSONL. Defecto: logs/trazas.jsonl
# HIDRO360_TRACE=logs/trazas.jsonl
# Fotografías de los reportes (también la usa la API). Defecto: media/ en la raíz.
# Los límites (3 fotos por reporte, 3 MB por foto) son constantes de config.py, no variables de entorno.
# HIDRO360_MEDIA_DIR=media

# --- IA (Gemini, opcional) -----------------------------------------------------------
# auto   = Gemini SOLO si GEMINI_API_KEY está definida; sin clave, modo local (valor por defecto)
# local  = reglas deterministas, sin enviar nada fuera (úselo para forzar el modo local aunque haya clave)
# gemini = fuerza Gemini; si falla se usa el modo local y queda registrado
AI_PROVIDER=auto
# Clave: https://aistudio.google.com/apikey  (límites y gratuidad: ver docs/IA_GEMINI.md; pueden cambiar)
# Déjela vacía o comentada para trabajar en modo local. Nunca la suba a Git.
# GEMINI_API_KEY=
# Modelo (sin editar código). Lista vigente: python -m scripts.verificar_gemini
# GEMINI_MODEL=gemini-3.5-flash-lite
# AI_TIMEOUT_SECONDS=15
# AI_MAX_REINTENTOS=1

# --- API: sin tokens solo acepta peticiones de escritura desde localhost -------------------
# Token de servicio (administración desde otros sistemas). Genere uno: openssl rand -hex 32
# (Windows: python -c "import secrets; print(secrets.token_hex(32))")
# HIDRO360_API_TOKEN=cambiar-por-un-valor-largo-y-aleatorio
# Token de dispositivo heredado (pantalla de monitoreo). Las terminales de cisterna usan un token propio por
# vehículo (X-Device-Token): se crea con  python -m scripts.registrar_dispositivo CIS-01
# HIDRO360_DEVICE_TOKEN=cambiar-por-otro-valor-largo-y-aleatorio

# --- Nombres antiguos (OBSOLETOS, siguen funcionando) --------------------------------------
# AGUA_CLARA_DB, AGUA_CLARA_TRACE, AGUA_CLARA_API_TOKEN, AGUA_CLARA_DEVICE_TOKEN equivalen a los HIDRO360_* de arriba.
# Si existen ambos, gana HIDRO360_*. No los use en instalaciones nuevas.
