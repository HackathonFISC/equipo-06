# Variables del servidor (se copia a /etc/hidro360/hidro360.env). No versionar el archivo real.
AGUA_CLARA_DB=/var/lib/hidro360/hidro360.db
AGUA_CLARA_TRACE=/var/lib/hidro360/trazas.jsonl
# Tokens de la API: genere valores largos y aleatorios (p. ej. `openssl rand -hex 24`).
AGUA_CLARA_API_TOKEN=CAMBIAR
AGUA_CLARA_DEVICE_TOKEN=CAMBIAR
# IA: auto = Gemini solo si hay clave; local = reglas sin enviar nada; gemini = forzar Gemini (si falla, modo local).
AI_PROVIDER=auto
# GEMINI_API_KEY=pegue-aqui-su-clave
# GEMINI_MODEL=gemini-3.5-flash-lite
