[Unit]
Description=HIDRO360 - API FastAPI
After=network-online.target
Wants=network-online.target

[Service]
User=hidro360
WorkingDirectory=/opt/hidro360
EnvironmentFile=/etc/hidro360/hidro360.env
ExecStart=/opt/hidro360/.venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/hidro360

[Install]
WantedBy=multi-user.target
