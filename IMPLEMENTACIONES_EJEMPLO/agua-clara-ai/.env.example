# Copia este archivo como .env y pon tus valores reales.
# NUNCA subas .env al repositorio (ya está en .gitignore).

# --- Modelo de lenguaje (opcional) ---
# Si estas variables no existen o la red falla, la app usa extracción por reglas
# y plantillas fijas: la demo sigue funcionando sin internet.
#
# Prioridad de proveedores: xAI (Grok) -> AGUA_LLM_* (genérico, p.ej. Gemini) -> OpenAI -> Gemini.
# Puedes definir varias: gana la primera que responda.
AGUA_LLM_BASE_URL=https://api.openai.com/v1
AGUA_LLM_API_KEY=pon-tu-clave-aqui
AGUA_LLM_MODEL=gpt-4o-mini

# xAI / Grok (opcional). Base compatible con OpenAI.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4

# OpenAI directo (opcional). También lo usa la visión de Poseidón (gpt-4o).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini (opcional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Canal WhatsApp (opcional) ---
# Sin credenciales, el webhook sigue funcionando para simulación (ver vista
# "Canal WhatsApp" en la SPA); las respuestas y avisos quedan en el outbox.
WHATSAPP_VERIFY_TOKEN=agua-clara-demo
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=

# --- Proyecto Poseidón: persistencia en la nube (opcional) ---
# Solo si defines ambas y el paquete `supabase` está instalado; si no, usa SQLite.
SUPABASE_URL=
SUPABASE_KEY=

# --- Canal de avisos Telegram (opcional) ---
# Sin token, los avisos aprobados se guardan en la "bandeja de salida" (outbox)
# y se muestran en el panel; no se envía nada real.
AGUA_TELEGRAM_TOKEN=
AGUA_TELEGRAM_CHAT_ID=
